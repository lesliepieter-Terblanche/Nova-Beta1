# Copy this file to .env and fill in your keys. .env is never uploaded to GitHub.

# ElevenLabs (your subscription) — elevenlabs.io -> Profile -> API Keys
ELEVENLABS_API_KEY=
# Optional: your own voice ID (elevenlabs.io -> Voices -> ... -> Copy voice ID). Blank = stock "George".
ELEVENLABS_VOICE_ID=

# Gemini — FREE key from https://aistudio.google.com/apikey  (smart brain + vision)
GEMINI_API_KEY=

# Groq — FREE key from https://console.groq.com/keys  (backup brain)
GROQ_API_KEY=
# xAI Grok (paid): console.x.ai — keys start with xai-
XAI_API_KEY=
# Encrypts Nova's nightly backups (created for you the first time if empty — keep a copy!)
NOVA_BACKUP_PASSPHRASE=

# Telegram — create a bot with @BotFather, paste its token here
TELEGRAM_BOT_TOKEN=

# EskomSePush — FREE token (50 checks/day) from https://eskomsepush.gumroad.com/l/api (load-shedding schedule)
ESP_TOKEN=

# Pexels — FREE key from https://www.pexels.com/api/ (stock footage for videos)
PEXELS_API_KEY=

# ── optional, only for MCP servers you enable in config.yaml ──
HA_TOKEN=
GITHUB_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
