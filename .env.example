# Copy this file to .env and fill in your keys. .env is never uploaded to GitHub.

# ElevenLabs (your subscription) — elevenlabs.io -> Profile -> API Keys
ELEVENLABS_API_KEY=
# Optional: your own voice ID (elevenlabs.io -> Voices -> ... -> Copy voice ID). Blank = stock "George".
ELEVENLABS_VOICE_ID=

# Gemini — FREE key from https://aistudio.google.com/apikey  (smart brain + vision)
GEMINI_API_KEY=

# Groq — FREE key from https://console.groq.com/keys  (backup brain)
GROQ_API_KEY=

# Telegram — create a bot with @BotFather, paste its token here
TELEGRAM_BOT_TOKEN=

# ── optional, only for MCP servers you enable in config.yaml ──
HA_TOKEN=
GITHUB_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
